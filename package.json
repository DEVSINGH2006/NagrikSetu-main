{
  "name": "nagriksetu-root",
  "version": "1.0.0",
  "description": "NagrikSetu — India's Civic Accountability Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm run build --prefix frontend",
    "build:all": "npm run install:all && npm run build",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend"
  },
  "keywords": [
    "civic-tech",
    "nagriksetu",
    "smart-city",
    "vadodara",
    "react",
    "express",
    "sqlite"
  ],
  "author": "NagrikSetu Team",
  "license": "MIT",
  "dependencies": {
    "mongoose": "^9.11.2"
  }
}
